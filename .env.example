# Copy to ~/.config/bunker/.env (one file for every repo). A repo's .bunker/.env (gitignore it) or exported vars override it.

# Claude subscription: run `claude setup-token` on the host and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=

# Models per role (all optional; unset = Claude Code's default). A --model / --<role>-model flag overrides these.
# BUNKER_MODEL=claude-sonnet-5-5            # every role
# BUNKER_IMPLEMENTER_MODEL=
# BUNKER_REVIEWER_MODEL=
# BUNKER_AUDITOR_MODEL=

# Or bill an Anthropic API key instead: uncomment and fill in.
# ANTHROPIC_API_KEY=
